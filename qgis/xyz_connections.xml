<!DOCTYPE connections>
<!--
  Ulmer Schachtel – Hintergrundkarten als XYZ-Tile-Verbindungen.

  Import in QGIS: Browser-Panel → Rechtsklick auf "XYZ Tiles"
                  → "Verbindungen laden…" → diese Datei wählen.

  Danach erscheinen alle Karten unter XYZ Tiles und lassen sich per
  Doppelklick als Layer laden. Unter die eigenen Vektordaten legen.

  Hinweis: Alle Dienste brauchen eine Internetverbindung. Für Offline-
  Nutzung in QField müssen die Kacheln als MBTiles/GeoPackage-Raster
  gecacht werden (siehe docs/02_qfield_export.md, Option B Schritt 3).
-->
<qgsXYZTilesConnections version="1.0">
  <!-- Neutrale, helle Alltags-Basemaps – ruhiger als OSM Standard, lassen die Sepia-Marker leuchten.
       OSM Standard ist absichtlich nicht enthalten: zu bunt, dominiert die eigenen thematischen Layer. -->

  <!-- Stadia Alidade Smooth: sehr matter, entsättigter Stil – ideal für Sepia-Overlays.
       Anonym von localhost erlaubt (QGIS Desktop, lokale Entwicklung).
       Key nötig sobald nicht-localhost: QFieldSync-Export, anderes Gerät, Server.
       Kostenloser Free-Tier: https://client.stadiamaps.com → registrieren → API Key.
       Key einbauen: …/{z}/{x}/{y}.png?api_key=DEIN_KEY
       Einfärben: Layereigenschaften → Symbolisierung → Farbwiedergabe:
         Sättigung -70 · Helligkeit +15 · Kontrast -15 · Transparenz 85–90 % -->
  <xyztiles name="Stadia Alidade Smooth (matt, Sepia-tauglich)" url="https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png" zmin="0" zmax="20" referer="" username="" password="" authcfg="" tilePixelRatio="0"/>

  <xyztiles name="CARTO Positron (hell, dezent)" url="https://a.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png" zmin="0" zmax="20" referer="" username="" password="" authcfg="" tilePixelRatio="0"/>
  <!-- light_nolabels: identisch mit light_all, aber ohne Ortsnamen/Straßenbeschriftung.
       Sinnvoll wenn man eigene Labels (Labels-Overlay-Layer oder QGIS-Labeling) nutzt
       und Doppelbeschriftung vermeiden will. Kombination: nolabels + "Labels: dezent hell"
       gibt identisches Ergebnis wie light_all, aber mit Kontrolle über Sichtbarkeit. -->
  <xyztiles name="CARTO Positron (ohne Labels)" url="https://a.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}.png" zmin="0" zmax="20" referer="" username="" password="" authcfg="" tilePixelRatio="0"/>
  <xyztiles name="CARTO Voyager (hell, mehr Detail)" url="https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png" zmin="0" zmax="20" referer="" username="" password="" authcfg="" tilePixelRatio="0"/>

  <!-- Bahn-spezifischer Overlay – Strecken, Elektrifizierung, Bahnhöfe.
       Nur für Datencheck beim Bearbeiten (Quervergleich mit eigenen CFR-Vektorlayern).
       Nicht für QField-Export: die eigenen Bahnlinien/Bahnhöfe-Layer ersetzen ihn.
       Halbtransparent verwenden: Layer-Transparenz 60–70 %. -->
  <xyztiles name="OpenRailwayMap (Bahn-Overlay)" url="https://a.tiles.openrailwaymap.org/standard/{z}/{x}/{y}.png" zmin="2" zmax="19" referer="" username="" password="" authcfg="" tilePixelRatio="0"/>

  <!-- Reine Label-Overlays (transparent) – moderne Orts- & Straßennamen zum Drüberlegen,
       v. a. über die labelfreien Karten (historische Militäraufnahmen, Satellit). Zoom-abhängig:
       weit draußen Ortsnamen, beim Reinzoomen Straßennamen. Ganz nach oben in den Stapel legen. -->
  <!-- tilePixelRatio=2 + @2x = Retina/HiDPI: auf Handys (QField) deutlich größere, scharfe Labels. -->
  <xyztiles name="Labels: Orte &amp; Straßen (CARTO Voyager)" url="https://a.basemaps.cartocdn.com/rastertiles/voyager_only_labels/{z}/{x}/{y}@2x.png" zmin="0" zmax="20" referer="" username="" password="" authcfg="" tilePixelRatio="2"/>
  <xyztiles name="Labels: dezent hell (CARTO Positron)" url="https://a.basemaps.cartocdn.com/light_only_labels/{z}/{x}/{y}@2x.png" zmin="0" zmax="20" referer="" username="" password="" authcfg="" tilePixelRatio="2"/>

  <!-- Gelände/Relief – wegen der Karpaten (Brașov, Sighișoara) -->
  <xyztiles name="OpenTopoMap (Höhenlinien + Relief)" url="https://tile.opentopomap.org/{z}/{x}/{y}.png" zmin="0" zmax="17" referer="" username="" password="" authcfg="" tilePixelRatio="0"/>
  <xyztiles name="ESRI World Hillshade (reines Relief)" url="https://server.arcgisonline.com/ArcGIS/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}" zmin="0" zmax="16" referer="" username="" password="" authcfg="" tilePixelRatio="0"/>

  <!-- Satellit – gezielt fürs Donaudelta (Wasserkanäle bei Sulina, Sf. Gheorghe, Letea) -->
  <xyztiles name="ESRI World Imagery (Satellit)" url="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}" zmin="0" zmax="19" referer="" username="" password="" authcfg="" tilePixelRatio="0"/>

  <!--
    Habsburger Militäraufnahmen – historische Grundkarten via Arcanum Maps (mapire.eu).
    Brauchen einen Referer-Header (hier hinterlegt). Maßstab original ca. 1:28 800.
    Frei nutzbar für nicht-kommerzielle Zwecke. © Arcanum Maps / HM Hadtörténeti Intézet.

    Wichtig für dieses Projekt: Nur die europe-*-Layer haben Abdeckung für Rumänien.
    Die -transylvania-spezifischen Layer liefern für RO leere Tiles — nicht verwenden.

    Hinweis „zugeschnittene Karte": Diese Live-XYZ-Layer decken halb Europa ab. Um die
    historische Karte NUR über Rumänien+Österreich-Ungarn zu zeigen (außen eine andere
    Basiskarte), erzeugt `tools/fetch_arcanum_clip.py` aus Survey 2 ein lokales,
    zugeschnittenes GeoTIFF (data/raster/, außen transparent) — QGIS kann ein Raster
    nicht auf der Leinwand clippen. Den entfernten „Arcanum 2."-Layer hält
    `qgis_setup_scales.py` daher aus (BASEMAPS_OFF); der lokale Clip ersetzt ihn.

    1. Josephinische Landesaufnahme (1763–1790) — „europe-18century-firstsurvey"
       Auftraggeber: Kaiserin Maria Theresia, fortgesetzt unter Joseph II.
       Erster systematischer Geländeaufnahme des gesamten Habsburgerreichs.
       Siebenbürgen: ca. 1769–1773. Maßstab ca. 1:28 800.
       Beschriftung: Deutsch und Lateinisch, Orte mit deutschen/ungarischen Namen.
       → Zeitlich parallel zur Ulmer-Schachtel-Ära: Auswanderer fuhren genau in
         diesen Jahrzehnten die Donau hinunter ins Banat. Karte zeigt das Banat
         und die Walachei ohne jede Eisenbahn — nur Feldwege und Flussübergänge.
         Passt zur Stil-Referenz von Reilly 1791 (selbes Jahrzehnt).

    2. Franziszeische Landesaufnahme (1806–1869) — „europe-19century-secondsurvey"
       Auftraggeber: Kaiser Franz I. Erstmals auf Triangulation basierend.
       Siebenbürgen: ca. 1853–1869. Maßstab ca. 1:28 800.
       Zeigt den Übergang zur Eisenbahnzeit: Erste rumänische Eisenbahn
       Oravița–Baziaș eröffnete 1854. Frühe Bahnlinien auf späteren Blättern sichtbar.
       CFR noch nicht gegründet (1888), aber Vorläuferbahnen schon in Betrieb.

    3. Franzisco-Josephinische Landesaufnahme (1869–1887) — „europe-19century-thirdsurvey"
       Auftraggeber: Kaiser Franz Joseph I. Höhere Triangulationsgenauigkeit,
       Maßstab 1:25 000. Siebenbürgen: ca. 1873–1876.
       Zeigt das bereits entwickelte Bahnnetz — direkte Vorgänger der heutigen
       CFR-Magistralen sind erkennbar. Vergleich mit rail_lines.geojson möglich.
  -->
  <xyztiles name="Arcanum 1. Militäraufnahme (1763–1790)" url="https://tiles.arcanum.com/mercator/europe-18century-firstsurvey/{z}/{x}/{y}" zmin="5" zmax="14" referer="https://maps.arcanum.com" username="" password="" authcfg="" tilePixelRatio="0"/>
  <xyztiles name="Arcanum 2. Militäraufnahme (1806–1869)" url="https://tiles.arcanum.com/mercator/europe-19century-secondsurvey/{z}/{x}/{y}" zmin="5" zmax="14" referer="https://maps.arcanum.com" username="" password="" authcfg="" tilePixelRatio="0"/>
  <xyztiles name="Arcanum 3. Militäraufnahme (1869–1887)" url="https://tiles.arcanum.com/mercator/europe-19century-thirdsurvey/{z}/{x}/{y}" zmin="5" zmax="14" referer="https://maps.arcanum.com" username="" password="" authcfg="" tilePixelRatio="0"/>
</qgsXYZTilesConnections>
