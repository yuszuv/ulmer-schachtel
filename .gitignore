# Python
__pycache__/
*.py[cod]
.venv/

# QField-Exportpakete
qfield/

# QGIS
*.qgz~
*.qgs~

# Generierte GIS-Bündel (aus GeoJSON via 'reiseplan-cli build-gpkg')
*.gpkg

# Lokale Arbeits-/Scratch-Dateien
tmp/

# QField-Arbeitsexporte (lokal, nicht versioniert) – generische Muster,
# damit künftige Export-Versionen nicht versehentlich committet werden.
qgis/*_qfield.qgs
qgis/main_qfield.qgs
qgis/*_attachments.zip
qgis/v*.zip

# OSM-Roh-Cache (regenerierbar via tools/fetch_cfr_data.py)
data/raw/osm_ro_stations.json
