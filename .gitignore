# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Editor (nvim, vscode)
.*.sw[a-p]
.vscode/

# Claude Code agent memory (local, not repo content)
.claude/

# QField export packages
qfield/

# QGIS
*.qgz~
*.qgs~

# Generated GIS bundle (from GeoJSON via 'reiseplan-cli build-gpkg')
*.gpkg

# Local scratch files
tmp/

# Generated website (from GeoJSON via 'tools/build_site.py'; deployed to Pages by CI)
site/

# QField exports belong in qfield/ (fully ignored above), never in qgis/.
# This keeps qgis/ a pure source folder (reiseplan.qgz, styles/, …) and makes
# an accidentally placed export immediately visible in 'git status'.

# OSM raw cache (regenerate via tools/fetch_cfr_data.py)
data/raw/osm_ro_stations.json
