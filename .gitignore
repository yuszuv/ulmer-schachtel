# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Editor (nvim, vscode)
.*.sw[a-p]
.vscode/

# Claude Code agent memory (local, not repo content)
.claude/

# QField export packages
qfield/

# QGIS
*.qgz~
*.qgs~

# Generated GIS bundle (from GeoJSON via 'reiseplan-cli build-gpkg')
*.gpkg

# Local clipped raster + WMS tile cache (regenerate via 'python tools/fetch_arcanum_clip.py';
# large + reproducible — the cutline arcanum_clip.geojson IS committed)
data/raster/
data/raw/arcanum2_tilecache/
data/raw/arcanum2_secondsurvey.wms.xml

# Local scratch files
tmp/
gemini/

# Generated website (from GeoJSON via 'tools/build_site.py'; deployed to Pages by CI)
site/

# QField exports belong in qfield/ (fully ignored above), never in qgis/.
# This keeps qgis/ a pure source folder (reiseplan.qgz, styles/, …) and makes
# an accidentally placed export immediately visible in 'git status'.

# OSM raw caches (regenerate via `uv run reiseplan-fetch` / `reiseplan-cli
# fetch-wikivoyage`): stations, rail-track geometry, cities. README.md stays.
data/raw/osm_ro_*.json
